{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexa-auth",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "auth.pcln.top/*", "zone_name": "pcln.top" }],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": { "WEB_ORIGIN": "https://pcln.top" },
  "d1_databases": [{ "binding": "DB", "database_name": "pcln-production", "database_id": "453ca043-67cf-425e-9548-ec125e8389eb", "migrations_dir": "migrations" }],
  "env": { "local": {
    "name": "nexa-auth",
    "vars": { "WEB_ORIGIN": "http://127.0.0.1:5730", "LOCAL_DEV": "true" },
    "d1_databases": [{ "binding": "DB", "database_name": "pcln-production", "database_id": "453ca043-67cf-425e-9548-ec125e8389eb", "migrations_dir": "migrations" }]
  } }
}
